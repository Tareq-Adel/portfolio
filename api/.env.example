# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# Resend API key (resend.com). Without this, the contact form logs the
# message instead of actually sending an email.
RESEND_API_KEY=

# Where contact form notifications are sent.
CONTACT_TO_EMAIL=tareq212adel@gmail.com

# Sender address Resend sends from. Must be onboarding@resend.dev (works
# immediately, no setup) or an address on a domain you've verified with Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Salt for hashing visitor IPs before rate-limiting (not security-critical,
# but change it from the default in production).
CONTACT_IP_SALT=

# Comma-separated list of origins allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
