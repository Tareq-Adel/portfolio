{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "portfolio-api": {
      "root": "api",
      "framework": "express"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "portfolio-api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
